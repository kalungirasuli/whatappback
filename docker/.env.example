# WhatsApp
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=verify_token_change_me

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/whatappseller

# Redis
REDIS_URL=redis://redis:6379/0

# Queue
QUEUE_TYPE=memory

# Object Storage (MinIO)
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=whatappseller-images
CDN_BASE_URL=http://localhost:9000/whatappseller-images

# Qdrant
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=products

# Admin
ADMIN_JWT_SECRET=change-me-in-production
ADMIN_SESSION_EXPIRE_HOURS=8

# Rate Limiting
RATE_LIMIT_PER_PHONE=10
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_PER_IP=100
REGISTER_RATE_LIMIT_PER_NUMBER=3
REGISTER_RATE_LIMIT_WINDOW_HOURS=24

# New Merchant Soft Window
NEW_MERCHANT_WINDOW_DAYS=7
NEW_MERCHANT_MAX_LISTINGS_PER_DAY=3

# Logging
LOG_LEVEL=INFO

# AI Pipeline
SIGLIP_MODEL=sentence-transformers/clip-ViT-B-32
DINOV2_MODEL=facebook/dinov2-base
YOLO_CONFIDENCE=0.5
MODERATION_MAX_SIZE_MB=10
