  # WhatsApp
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# Database (Docker uses 5433 to avoid conflicts with existing postgres)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/whatappseller

# Redis (Docker uses 6380 to avoid conflicts with existing redis)
REDIS_URL=redis://localhost:6380/0

# Queue
QUEUE_TYPE=memory  # memory | sqs | rabbitmq | bullmq
SQS_QUEUE_URL=
RABBITMQ_URL=
BULLMQ_REDIS_URL=

# Object Storage
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=whatappseller-images
CDN_BASE_URL=http://localhost:9000/whatappseller-images

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=products

# Admin
ADMIN_JWT_SECRET=change-me-in-production
ADMIN_SESSION_EXPIRE_HOURS=8

# Rate Limiting
RATE_LIMIT_PER_PHONE=10
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_PER_IP=100
REGISTER_RATE_LIMIT_PER_NUMBER=3
REGISTER_RATE_LIMIT_WINDOW_HOURS=24

# New Merchant Soft Window
NEW_MERCHANT_WINDOW_DAYS=7
NEW_MERCHANT_MAX_LISTINGS_PER_DAY=3

# Logging
LOG_LEVEL=INFO
